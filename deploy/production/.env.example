# Copy to the repository root as .env on the target host.
# Replace every CHANGE_ME value with a unique generated secret and set mode 0600.

NEXORA_HOST=fablebd.com
NEXORA_ENVIRONMENT=production
COMPOSE_PROFILES=core,automation,ai

POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_unique_postgres_password
DATABASE_URL=postgresql+asyncpg://nexora:CHANGE_ME_unique_postgres_password@postgres:5432/nexora
DATABASE_URL_SYNC=postgresql+psycopg://nexora:CHANGE_ME_unique_postgres_password@postgres:5432/nexora

REDIS_PASSWORD=CHANGE_ME_unique_redis_password
REDIS_URL=redis://:CHANGE_ME_unique_redis_password@redis:6379/0

SECRET_KEY=CHANGE_ME_unique_api_secret_at_least_32_characters
AUTOMATION_API_KEY=CHANGE_ME_unique_automation_secret_at_least_32_characters
WORKSPACE_API_KEY=CHANGE_ME_unique_workspace_secret_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://fablebd.com
NEXT_PUBLIC_API_URL=https://fablebd.com/api/v1
INTERNAL_API_URL=http://api:8000/api/v1

MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=CHANGE_ME_unique_minio_password
MINIO_ENDPOINT=http://minio:9000
QDRANT_URL=http://qdrant:6333

WORKER_POLL_SECONDS=2
WORKER_LOCK_SECONDS=300
WORKER_HEARTBEAT_SECONDS=10
CONNECTOR_TIMEOUT_SECONDS=30
EVENT_STREAM_KEY=nexora:events
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=180

# Server-authoritative AI routing. Keep route hints disabled in production unless a
# reviewed n8n workflow requires them; clients can never add arbitrary providers/models.
AI_POLICY_VERSION=ai-routing-v1
AI_ALLOW_ROUTE_HINTS=false
AI_MAX_PROMPT_BYTES=65536

# Optional OpenAI-compatible cloud provider. Keep disabled until its exact model
# allowlist, budget and server-side secret have been approved. Never commit the key.
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_ALLOWED_MODELS=
CLOUD_LLM_DEFAULT_MODEL=
CLOUD_LLM_TIMEOUT_SECONDS=120

# Optional Manus asynchronous delegation. Keep disabled until the project ID,
# agent profile, connector/skill allowlists and server-side key are approved.
MANUS_ENABLED=false
MANUS_API_BASE_URL=https://api.manus.ai
MANUS_API_KEY=
MANUS_PROJECT_ID=
MANUS_ALLOWED_AGENT_PROFILES=manus-1.6-lite,manus-1.6
MANUS_DEFAULT_AGENT_PROFILE=manus-1.6
MANUS_ALLOWED_CONNECTOR_IDS=
MANUS_ALLOWED_SKILL_IDS=
MANUS_ALLOW_ACCOUNT_DEFAULT_SKILLS=false
MANUS_TIMEOUT_SECONDS=30
MANUS_WEBHOOK_PUBLIC_URL=https://fablebd.com/api/v1/webhooks/manus
MANUS_WEBHOOK_MAX_AGE_SECONDS=300
MANUS_WEBHOOK_MAX_BODY_BYTES=1048576
MANUS_PUBLIC_KEY_TTL_SECONDS=3600
MANUS_DAILY_TASK_LIMIT=5
MANUS_CONCURRENCY_LIMIT=1

# Automation profile
N8N_ENCRYPTION_KEY=CHANGE_ME_unique_n8n_encryption_key
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=nexora
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_unique_n8n_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_unique_grafana_password

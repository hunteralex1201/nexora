ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://nexora:CHANGE_ME_local_postgres_password@localhost:5432/nexora
REDIS_URL=redis://:CHANGE_ME_local_redis_password@localhost:6379/0
DEPENDENCY_TIMEOUT_SECONDS=2
WORKER_POLL_SECONDS=2
WORKER_LOCK_SECONDS=300
WORKER_HEARTBEAT_SECONDS=10
CONNECTOR_TIMEOUT_SECONDS=30
EVENT_STREAM_KEY=nexora:events
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=180

CORS_ORIGINS=http://localhost:3000

SECRET_KEY=CHANGE_ME_with_at_least_32_random_characters
AUTOMATION_API_KEY=CHANGE_ME_with_a_different_32_character_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

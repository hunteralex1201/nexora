# NEXORA local development environment only.
# Copy this file to .env and replace every value marked CHANGE_ME before any shared deployment.

NEXORA_ENVIRONMENT=development
COMPOSE_PROFILES=core

# PostgreSQL
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_local_postgres_password
DATABASE_URL=postgresql+asyncpg://nexora:CHANGE_ME_local_postgres_password@postgres:5432/nexora
DATABASE_URL_SYNC=postgresql+psycopg://nexora:CHANGE_ME_local_postgres_password@postgres:5432/nexora

# Redis
REDIS_PASSWORD=CHANGE_ME_local_redis_password
REDIS_URL=redis://:CHANGE_ME_local_redis_password@redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_with_at_least_32_random_characters
AUTOMATION_API_KEY=CHANGE_ME_with_a_different_32_character_random_value
WORKSPACE_API_KEY=CHANGE_ME_with_a_third_32_character_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1

# Object and vector storage
MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=CHANGE_ME_local_minio_password
MINIO_ENDPOINT=http://minio:9000
QDRANT_URL=http://qdrant:6333

# Worker and local AI runtime
WORKER_POLL_SECONDS=2
WORKER_LOCK_SECONDS=300
WORKER_HEARTBEAT_SECONDS=10
CONNECTOR_TIMEOUT_SECONDS=30
EVENT_STREAM_KEY=nexora:events
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=180

# Optional automation profile
N8N_ENCRYPTION_KEY=CHANGE_ME_with_at_least_32_random_characters
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=nexora
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_local_n8n_password

# Optional monitoring profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_local_grafana_password

{
  "id": "nexora-collection-schedule",
  "name": "NEXORA - Scheduled Source Collection",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "collection-schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 240]
    },
    {
      "parameters": {},
      "id": "collection-manual-trigger",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [260, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXORA_API_BASE_URL + '/commerce/automation/collect' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.NEXORA_AUTOMATION_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ run_id: 'collect-' + $now.toFormat('yyyyMMddHH') }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "collection-api-request",
      "name": "Queue Approved Collection Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 320],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Queue Approved Collection Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test": {
      "main": [
        [
          {
            "node": "Queue Approved Collection Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka",
    "saveManualExecutions": true
  },
  "staticData": null,
  "pinData": {},
  "tags": []
}

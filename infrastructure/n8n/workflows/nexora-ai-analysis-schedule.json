{
  "id": "nexora-ai-analysis-schedule",
  "name": "NEXORA - Daily Evidence Analysis",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 2 * * *"
            }
          ]
        }
      },
      "id": "ai-schedule-trigger",
      "name": "Daily at 02:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 240]
    },
    {
      "parameters": {},
      "id": "ai-manual-trigger",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [260, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXORA_API_BASE_URL + '/commerce/automation/ai' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.NEXORA_AUTOMATION_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ run_id: 'ai-' + $now.toFormat('yyyyMMdd'), max_products: 20, data_class: 'internal' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "ai-api-request",
      "name": "Queue Evidence Analysis Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 320],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Daily at 02:30": {
      "main": [
        [
          {
            "node": "Queue Evidence Analysis Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test": {
      "main": [
        [
          {
            "node": "Queue Evidence Analysis Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka",
    "saveManualExecutions": true
  },
  "staticData": null,
  "pinData": {},
  "tags": []
}

# REVIEW-ONLY TEMPLATE. Copy to .env only after an approved change record.
# Never commit the real .env file or any gateway token.

# Must be an official stable GHCR tag plus immutable sha256 digest.
# Example format only; replace the placeholder digest after provenance verification.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST

# Set exactly to CHANGE_RECORD_APPROVED only after the approval checklist is signed.
NEXORA_OPENCLAW_APPROVED=NOT_APPROVED

# Generate a unique high-entropy secret at deployment time; do not reuse NEXORA credentials.
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
